ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=postgresql://localhost/networking_tower
EXA_API_KEY=your_exa_key
EXA_SEARCH_COST_USD=0.005
RESEND_API_KEY=your_resend_key
AUTH_PASSWORD=your_local_password

# Claude connector (MCP). Any long random string — it's the whole auth for /mcp/<token>.
# Generate one with: openssl rand -hex 24
MCP_TOKEN=generate_a_long_random_token

# Optional Dust programmatic integration
DUST_API_KEY=your_dust_api_key
DUST_WORKSPACE_ID=your_dust_workspace_id
EXA_API_KEY=your_exa_key_here
RESEND_API_KEY=re_your_key_here
RECIPIENT_EMAIL=your_email@gmail.com
AUTH_PASSWORD=choose_a_strong_password
